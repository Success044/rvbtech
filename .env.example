# Keep real secrets in .env or hosting secrets. This file contains no real keys.
RESEND_API_KEY=
# Bare sender address on your verified Resend domain; never use the visitor's email here.
CONTACT_FROM_EMAIL=
# Fixed business inbox; visitor copies are sent separately to the validated form email.
CONTACT_TO_EMAIL=rvbtech10@gmail.com

# Production Turnstile widget. Only the site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local development only: use Cloudflare's published test key pair here.
NEXT_PUBLIC_TURNSTILE_TEST_SITE_KEY=
TURNSTILE_TEST_SECRET_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated website origins, including https://. No paths or wildcards.
# Production must use its actual HTTPS origin; local dev also accepts localhost.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Public Sanity project configuration. Studio and the website share these values.
SANITY_STUDIO_PROJECT_ID=f7mpzpv1
SANITY_STUDIO_DATASET=production
# Use local only during migration; sanity reads published CMS content.
SERVICES_MEDIA_SOURCE=sanity
# Optional, server-only: required if the dataset is private. Never use a public prefix.
SANITY_API_READ_TOKEN=
